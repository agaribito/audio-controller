<Window x:Class="audio_controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:audio_controller"
        mc:Ignorable="d"
        Title="Audio Controller" Height="250" Width="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <!-- 角丸カード風の枠組み -->
    <Border Background="#181825" CornerRadius="16" Padding="20">
        <Grid>
            <!-- 右上の「×」ボタン -->
            <Button Content="✕" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Foreground="#CDD6F4" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    FontSize="14" 
                    Cursor="Hand"
                    Click="CloseButton_Click"/>

            <StackPanel VerticalAlignment="Center">
                <!-- タイトル -->
                <TextBlock Text="Audio Controller" 
                           Foreground="#89B4FA" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <!-- 音量表示 -->
                <TextBlock x:Name="lblVolume" 
                           Text="🔊 音量: 50%" 
                           Foreground="#CDD6F4" 
                           FontSize="16" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,15"/>

                <!-- スライダー -->
                <Slider x:Name="sliderVolume" 
                        Minimum="0" Maximum="100" Value="50"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="SliderVolume_ValueChanged"
                        Margin="10,0,10,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>